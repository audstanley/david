# david CalDAV Server Environment Variables
# Copy this file to /etc/default/david or /etc/sysconfig/david
# and customize as needed

# Server Configuration
DAVID_ADDRESS=127.0.0.1
DAVID_PORT=8000
DAVID_DIR=/var/lib/david
DAVID_PREFIX=/webdav

# API Configuration
DAVID_API_ADDRESS=127.0.0.1
DAVID_API_PORT=8080
DAVID_API_CORS_ENABLED=true
DAVID_API_CORS_ORIGINS=http://localhost:3000

# Authentication (REQUIRED - change in production!)
DAVID_JWT_SECRET=your-secret-key-change-in-production
DAVID_JWT_EXPIRY=24h
DAVID_JWT_REFRESH_EXPIRY=7d
DAVID_API_KEY_PREFIX=david_

# Database
DAVID_DATABASE_BASE_DIR=/var/lib/david

# Logging
DAVID_LOG_LEVEL=info
DAVID_LOG_PRODUCTION=false

# Rate Limiting
DAVID_API_RATE_LIMITING_ENABLED=true
DAVID_API_RATE_LIMITING_DEFAULT_LIMIT=100
DAVID_API_RATE_LIMITING_WINDOW=1m

# Recurrence
DAVID_RECURRENCE_CACHE_EXPIRY_DAYS=30
DAVID_RECURRENCE_MAX_CACHE_INSTANCES=1000
